---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | West Oak Therapy" description="The page you are looking for could not be found.">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 text-center bg-[#FDFCFB] text-[#2D2926]">
    <span class="text-[10px] tracking-[0.5em] uppercase text-[#8C3B24] font-bold mb-6 block">404</span>
    <h1 class="font-syne font-bold text-5xl md:text-7xl tracking-tighter mb-8">Page not found.</h1>
    <p class="text-xl text-[#2D2926]/50 font-light mb-12 max-w-md">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="px-10 py-4 bg-[#2D2926] text-white rounded-full text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-[#8C3B24] transition-all duration-500">
      Return Home
    </a>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoModal from '../components/VideoModal';
import PathPicker from '../components/PathPicker';
import { ArrowUpRight } from 'lucide-react';
---

<BaseLayout
  title="West Oak Therapy | Jennifer Weinmann, LMFT — Couples & Individual Therapy"
  description="Jennifer Weinmann, LMFT offers strategic, trauma-informed therapy for individuals, couples, and families in California. Specializing in RLT, co-occurring disorders, and relational repair."
  ogTitle="West Oak Therapy | The Relationship Thought Partner"
  ogDescription="Strategic therapy for motivated individuals and couples. Map the hidden pathways of connection to create lasting structural change."
>
  <!-- Ambient light -->
  <div class="fixed inset-0 z-0 pointer-events-none">
    <div class="absolute top-[-20%] left-[-10%] w-[70%] h-[70%] bg-[#E5E0DA]/30 blur-[150px] rounded-full animate-pulse" />
  </div>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex flex-col justify-end px-6 md:px-24 pb-12 md:pb-32 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero-home.png"
        alt="Solitary tree in misty field at sunrise — West Oak Therapy"
        class="w-full h-full object-cover brightness-90 contrast-110"
        width="1920"
        height="1080"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16 items-end">
      <div class="flex flex-col items-start pt-24 md:pt-0 lg:col-span-7 xl:col-span-8">
        <div class="flex flex-wrap gap-2 md:gap-3 mb-6 md:mb-8">
          {["Construct Meaning", "Map Connection", "Architect Peace"].map((tag) => (
            <span class="px-3 md:px-4 py-1.5 bg-white/10 backdrop-blur-md border border-white/20 rounded-full text-[8px] md:text-[9px] tracking-[0.2em] uppercase font-bold text-white/90">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="font-syne font-bold text-5xl md:text-7xl lg:text-7xl xl:text-8xl 2xl:text-9xl leading-[1.1] md:leading-[0.95] tracking-tighter mb-0 text-white">
          I understand <br class="hidden sm:block" />
          <span class="italic font-cormorant font-light text-[#D79E54] tracking-normal">hurt,</span> and I <br class="hidden sm:block" />
          understand <span class="italic font-cormorant font-light text-[#D79E54] tracking-normal">healing.</span>
        </h1>
      </div>

      <div class="flex flex-col items-start lg:col-span-5 xl:col-span-4 lg:pl-8 pb-4 md:pb-0">
        <!-- Video play button — React island -->
        <VideoModal client:load />

        <p class="text-base md:text-xl font-light leading-relaxed text-white/70 mb-8 md:mb-10 max-w-md">
          For motivated individuals and couples who want a strategic partner, not just another therapist. We map the hidden pathways of connection to create lasting structural change.
        </p>

        <a
          href="#why-here"
          class="w-full md:w-auto px-10 md:px-12 py-4 md:py-5 bg-white text-[#1A1A1A] rounded-full text-[10px] md:text-[11px] tracking-[0.3em] uppercase font-bold hover:bg-[#D79E54] hover:text-white transition-all duration-700 ease-in-out shadow-2xl text-center"
        >
          Start Your Reflection
        </a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about-jen" class="min-h-screen flex flex-col items-center justify-center px-6 md:px-8 py-20 md:py-32 bg-[#FAF9F6]">
    <div class="container mx-auto max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-24 items-center">
        <div class="relative order-2 md:order-1">
          <div class="aspect-[4/5] md:aspect-[1.1] rounded-[2rem] md:rounded-[2.5rem] overflow-hidden shadow-sm">
            <img src="/images/Jen-03.jpg" alt="Jennifer Weinmann, LMFT — West Oak Therapy" class="w-full h-full object-cover" width="800" height="900" />
          </div>
        </div>

        <div class="space-y-6 md:space-y-10 text-left order-1 md:order-2">
          <h2 class="font-syne font-bold text-4xl md:text-7xl tracking-tight text-[#2D2926] leading-[1.1]">
            Rooted in <br />
            <span class="italic font-cormorant font-light text-[#8C3B24]">Excellence.</span>
          </h2>

          <div class="space-y-4 md:space-y-6">
            <p class="text-base md:text-xl text-[#2D2926]/60 font-light leading-relaxed max-w-lg">
              I am Jennifer Weinmann. My practice is built on the intersection of deep clinical expertise and a modern, architectural approach to human connection.
            </p>
            <p class="text-base md:text-xl text-[#2D2926]/60 font-light leading-relaxed max-w-lg">
              We don't just talk about problems; we map the structural patterns that define your life, reinforcing what works and redesigning what doesn't.
            </p>
          </div>

          <div class="pt-2 md:pt-4">
            <a
              href="#why-here"
              class="flex items-center gap-4 text-[#8C3B24]/60 font-bold tracking-[0.2em] uppercase text-[10px] md:text-[11px] group transition-all duration-300 hover:text-[#8C3B24]"
            >
              Begin Your Mapping
              <svg class="w-4 h-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-500 opacity-40 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="mt-16 md:mt-32 bg-[#22333B] rounded-[2rem] md:rounded-[3rem] p-8 md:p-24 text-white relative overflow-hidden">
        <div class="relative z-10 max-w-3xl">
          <h3 class="text-[9px] md:text-[10px] tracking-[0.4em] uppercase font-bold text-[#D79E54] mb-6 md:mb-8">A Note About Fit</h3>
          <p class="text-xl md:text-4xl font-light leading-tight mb-8 md:mb-12">
            Clients who benefit most are ready for <span class="italic font-cormorant text-[#D79E54]">honest, sustained work</span> and want a therapist who combines clinical rigor with genuine empathy.
          </p>
          <div class="flex flex-wrap gap-2 md:gap-4">
            {["Clinical Rigor", "Genuine Empathy", "Sustained Change"].map((tag) => (
              <span class="px-3 py-1.5 md:px-4 md:py-2 bg-white/10 rounded-full text-[7px] md:text-[10px] tracking-widest uppercase border border-white/10 whitespace-nowrap">
                {tag}
              </span>
            ))}
          </div>
        </div>
        <div class="absolute inset-0 opacity-5 pointer-events-none bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:32px_32px]" />
      </div>
    </div>
  </section>

  <!-- Where Do We Begin Section -->
  <section id="why-here" class="min-h-screen flex flex-col items-center justify-center px-4 md:px-8 py-20 md:py-32 bg-[#FDFCFB]">
    <div class="container mx-auto max-w-4xl text-center">
      <div class="mb-12 md:mb-16 max-w-2xl mx-auto">
        <span class="text-[10px] tracking-[0.5em] uppercase text-[#8C3B24] font-bold mb-4 md:mb-6 block text-center">The Orientation</span>
        <h2 class="font-syne font-bold text-4xl md:text-7xl mb-6 md:mb-8 tracking-tight text-[#2D2926]">
          Where do we <br /> begin?
        </h2>
        <p class="text-base md:text-xl text-[#2D2926]/60 font-light leading-relaxed px-4">
          Select the path that most closely aligns with your current reality. This choice isn't permanent—it's simply the structural starting point for our reflection.
        </p>
      </div>

      <!-- Path picker — React island -->
      <PathPicker client:visible />
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-[#2D2926]/5 py-12 px-6 md:px-8">
    <div class="container mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-8 text-[#2D2926]/30 text-[10px] tracking-[0.4em] uppercase font-bold">
      <div>© 2026 Jennifer Weinmann / West Oak</div>
      <div class="flex gap-12">
        <span>Security</span>
        <span>Confidentiality</span>
      </div>
      <div class="flex gap-12">
        <a href="/about" class="hover:text-[#8C3B24] transition-colors duration-500">About Jennifer</a>
        <a href="/" class="hover:text-[#8C3B24] transition-colors duration-500">Return to Top</a>
      </div>
    </div>
  </footer>
</BaseLayout>
